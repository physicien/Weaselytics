#!/bin/bash

#SBATCH --job-name=SWEEP_2026-07-18
#SBATCH --account=rrg-cotemich-ac
#SBATCH --mail-type=END,FAIL          # Mail events (NONE,BEGIN,END,FAIL,ALL)
#SBATCH --mail-user=youremail@mail.com
#SBATCH --ntasks=1                    # cpus, if across several nodes
#SBATCH --cpus-per-task=8             # workers for the r2 sweep (-w)
#SBATCH --mem-per-cpu=1G              # memory, if across several nodes
##SBATCH --nodes=2                     # nb of whole nodes
##SBATCH --ntasks-per-node=12          # cpus, if whole node
##SBATCH --mem=24G                     # memory, mem=0 for all memory of the node
#SBATCH --time=00-03:00		      # time (DD-HH:MM)
#SBATCH --output=%x_%j.log 	      # output .log file

# Adapted from the REF_2026-04-19 script for the packaged layout of the
# plateau_segmentation branch. Differences with the old script:
#   - runs the installed package (python -m weaselytics) from the launch
#     directory instead of copying loose .py files into the workdir;
#   - populates the r2-curve cache (-cd) so the sweep only pays for the
#     expensive BEADS autocorrelation once; afterwards the plateau
#     detection can be re-run on the whole dataset in seconds with
#         python tools/plateau_proto.py <results>/r2_cache/*.npz
#   - no per-file mv: export_txt now sorts the *_bl.txt files into
#     per-molecule subdirectories of the output directory by itself;
#   - parallelizes the r2 sweep over $SLURM_CPUS_PER_TASK worker
#     processes (-w); the sweep is 99.9% of the compute in the REF run
#     (8358 s of autocorrelation vs 5.9 s of baseline correction), so
#     the 2.3 h of sweeps drop to roughly 20 min on 8 cpus.
# Submit from the repository root (the directory containing `data`).

#######################################
# Job variables and settings:
datadir=data
storage=$SLURM_TMPDIR
flags="-n -e -p"
cachedir=r2_cache

#######################################
# Files names
BASENAME=$SLURM_JOB_NAME

#######################################
# Create a local working directory
LAUNCHDIR=$PWD;
DATADIR=$LAUNCHDIR/$datadir
WORKDIR=$storage/$BASENAME"_"$SLURM_JOB_ID
mkdir -p $WORKDIR

# Copy this script to the working directory for provenance
cp "$(readlink -f $0)" "$WORKDIR"
cd $WORKDIR

module load scipy-stack
source /lustre09/project/6004866/$USER/virtualenv/HPLC_ENV/bin/activate

# Run the branch checked out in the launch directory
export PYTHONPATH="$LAUNCHDIR${PYTHONPATH:+:$PYTHONPATH}"

# One BLAS thread per worker process: the parallelism is at the level
# of the r2 sweep (-w), so threaded BLAS would only oversubscribe.
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1

for filename in $DATADIR/*/*.txt; do
  python -m weaselytics $filename $flags \
      -od $WORKDIR -cd $WORKDIR/$cachedir \
      -w ${SLURM_CPUS_PER_TASK:-1}
  printf "\n"
done

#Move the files to the local working directory
mv $LAUNCHDIR/$BASENAME"_"$SLURM_JOB_ID.log $WORKDIR
mv $WORKDIR $LAUNCHDIR
